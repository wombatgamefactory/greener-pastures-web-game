{
  "name": "greener-pastures-web-game",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/engine",
    "packages/data",
    "packages/ui",
    "packages/sim"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @gp/ui",
    "build": "npm run build --workspace @gp/ui",
    "preview": "npm run preview --workspace @gp/ui",
    "sim": "npm run sim --workspace @gp/sim --",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/data --noEmit && tsc -p packages/sim --noEmit && tsc -p packages/ui --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check:disclosure && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "knobs": "npm run sim -- --list-knobs",
    "check:disclosure": "node tools/check-disclosure.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
