# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*

# Editor / OS cruft
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*~

# Environment
.env
.env.local

# ---------------------------------------------------------------------------
# DISCLOSURE BOUNDARY
# This repo will be made public and shown to publishers. Everything below is
# design material, planning, or analysis that must stay private. These rules
# must be correct from the first commit: flipping the repo public exposes the
# entire history, not just the current tree.
# ---------------------------------------------------------------------------

# Wayfinder map, decision tickets, and research notes
.scratch/

# Throwaway probe scripts a ticket writes to answer one question and abandons.
.scratchprobe/
.probe/

# Captured bug reports and design notes (ticket 31). A capture carries the free
# text written about the game's weak spots, so it stays private - and it is what
# the browser's report button downloads and what a crashed sim run writes.
# The PUBLIC half is packages/sim/fixtures/, which is a capture stripped to its
# setup and move log by `--replay --fixture`.
captures/

# Simulator output: balance reports, complexity reports, run logs, cut lists.
# Deliberately not anchored to the repo root, so a report written into
# packages/sim/reports/ is caught too.
reports/
sim-out/
*.jsonl

# Source design material. Generated card data (packages/ui/public/data/*.json)
# still ships, because the game cannot run without it.
*.xlsm
*.xlsx
design/
*.tsbuildinfo

# Python bytecode. This is a DISCLOSURE rule, not a tidiness one: a .pyc embeds
# the absolute path of the source it was compiled from, so importing
# tools/extract_cards.py as a module (rather than running it as a script) writes
# the designer's private directory tree - and the game's unpublished title with
# it - into a file inside this repo. Caught by check:disclosure on 2026-08-13.
__pycache__/
*.pyc

# Working copies pulled from the shared card sheet (see tools/sheet-cards.mjs).
.sheet-cache/
packages/ui/public/sheet-cards.json
reports/cards/
